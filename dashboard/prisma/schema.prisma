// Prisma Schema untuk Smart Energy Meter & AI Appliance Profiling (NILM)
// Menggunakan MySQL database sesuai permintaan migrasi

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Device {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(255)
  location        String?       @db.VarChar(255)
  max_power_limit Int           @default(500) // Batas daya aman (Watt)
  relay_status    Boolean       @default(true) // True = ON, False = OFF
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  telemetries     Telemetry[]

  @@map("devices")
}

model Telemetry {
  id                 BigInt    @id @default(autoincrement())
  device_id          Int
  device             Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  voltage            Decimal   @db.Decimal(6, 2) // Volt (misal 220.50 V)
  power              Decimal   @db.Decimal(8, 2) // Daya aktif (misal 48.25 W)
  current            Decimal   @db.Decimal(6, 3) // Arus (misal 0.218 A)
  detected_appliance String?   @db.VarChar(150) // Hasil klasifikasi AI NILM
  appliance_category String?   @db.VarChar(100)
  confidence         Int?      @default(95)
  is_overload        Boolean   @default(false)
  recorded_at        DateTime  @default(now())

  @@index([device_id, recorded_at(sort: Desc)])
  @@map("telemetries")
}
