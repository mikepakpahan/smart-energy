# ==============================================================================
# Smart Energy Stack - Docker Environment Configuration Template
# Salin file ini menjadi '.env' di folder root sebelum menjalankan 'docker compose up -d'
# ==============================================================================

# Port mapping ke host OS
APP_PORT=3000
DB_PORT=3307

# Kredensial MySQL
DB_USER=root
DB_PASSWORD=1234
DB_NAME=smart_energy_db

# Kebijakan Auto-Pruning Data Telemetri (dalam satuan hari)
RETENTION_DAYS=7
